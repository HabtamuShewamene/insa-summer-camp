# Database
DATABASE_URL="postgresql://identity:identity_secret@localhost:5432/identity_db?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_MEMORY_COST=65536
