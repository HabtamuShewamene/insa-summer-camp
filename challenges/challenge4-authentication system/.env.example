# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=collaborative_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/collaborative_platform?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Secrets (CHANGE THESE IN PRODUCTION)
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_key_change_this_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@yourapp.com

# Application URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Node Environment
NODE_ENV=development